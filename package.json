{
  "name": "lawsync",
  "version": "1.2.2",
  "description": "LawSync Desktop Application",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:electron\" \"npm:dev:react\"",
    "dev:server": "cd server && npm run start",
    "dev:electron": "electron .",
    "build:react": "cd application && npm run build",
    "dev:react": "cd application && npm run dev",
    "build": "npx electron-builder --win nsis --x64 --publish=always"
  },
  "author": "Mohamed Salah",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "nsis": {
      "include": "installer.nsi",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LawSync"
    },
    "appId": "com.lawsync.desktop",
    "productName": "LawSync",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Mattar17",
        "repo": "LawSync"
      }
    ],
    "files": [
      "electron/**/*",
      "application/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "server/server.exe",
        "to": "server/server.exe"
      },
      {
        "from": "electron/bin/mongo",
        "to": "bin/mongo"
      }
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.7.3"
  }
}
