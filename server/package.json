{
  "name": "express",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "bin": "dist/bundle.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon src/index.js",
    "build:bundle": "esbuild index.js --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs",
    "build": "pkg dist/bundle.cjs --outputPath build/server --targets node22.22.0-win-x64 --output server.exe"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mongoose": "^9.0.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "nodemon": "^3.1.11"
  },
  "pkg": {
    "scripts": [
      "dist/bundle.cjs"
    ],
    "assets": [
      "cases_files/**/*",
      ".env"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "build"
  }
}
